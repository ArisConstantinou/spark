<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><UseWPF>true</UseWPF><OutputType>WinExe</OutputType>
    <AssemblyName>SparkWorld</AssemblyName><RootNamespace>SparkWorld</RootNamespace>
    <Version>0.2.2</Version>
    <PlatformTarget>x64</PlatformTarget><LangVersion>latest</LangVersion><Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings><AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ApplicationIcon Condition="Exists('$(SparkIcon)')">$(SparkIcon)</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="ACadSharp" Version="3.6.51" />
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
    <Compile Include="../cad/CadEngine.cs" Link="CadEngine.cs" />
    <Compile Include="../cad/CadScene.cs" Link="CadScene.cs" />
    <Compile Include="../cad/CadEntityGeometry.cs" Link="CadEntityGeometry.cs" />
    <Compile Include="../cad/CadInspection.cs" Link="CadInspection.cs" />
  </ItemGroup>
</Project>
